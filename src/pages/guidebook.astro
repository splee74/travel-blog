---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GUIDEBOOK } from '../consts';

const { title, price, purchaseUrl, pages, fileSize, tripDates, researchedOn } = GUIDEBOOK;
const priceText = `${price.toLocaleString('ko-KR')}원`;
const onSale = purchaseUrl !== '';

const chapters = [
  { no: '01', name: '왜 부산인가', desc: '바다의 세 얼굴, 꼭 먹어 볼 것, 차 없이 다니는 법, 지하철 그림 지도', pages: '3–6쪽' },
  { no: '02', name: '코스별 일정', desc: '바다 풀코스 · 여유 힐링 · 시장 먹방 세 코스의 시간표와 지역별 장소 노트', pages: '7–21쪽' },
  { no: '03', name: '숙소', desc: '광안리에 묵는 이유, 후보 7곳 비교, 예약 전에 전화로 물어볼 것', pages: '22–23쪽' },
  { no: '04', name: '축제', desc: '여행 날 볼 수 있는 드론쇼·거리공연, 11월의 다른 축제', pages: '24–25쪽' },
  { no: '05', name: '예산', desc: '1인 총비용, 코스별 현지 비용, 아끼는 법과 준비물 체크리스트', pages: '26–28쪽' },
];

const samples = [
  { src: '/images/guidebook/courses.jpg', alt: '세 코스를 걷는 양·카페·비용으로 비교한 표', caption: '세 코스 한눈에 비교' },
  { src: '/images/guidebook/course-a-day1.jpg', alt: '코스 A 1일차 시간대별 일정표', caption: '시간대별 일정과 추천 이유' },
  { src: '/images/guidebook/stays.jpg', alt: '광안리 숙소 후보 7곳 비교표와 예약 전 확인 목록', caption: '숙소 후보 비교' },
  { src: '/images/guidebook/budget.jpg', alt: '1인 총비용과 출발역별 기차 요금 표', caption: '1인 예산 계산' },
];

const forWhom = [
  { icon: '🚄', title: '운전 없이 가고 싶은 분', text: '기차·지하철·버스·택시만으로 짠 일정이에요. 이동마다 노선과 걸리는 시간을 적었어요.' },
  { icon: '👨‍👩‍👧', title: '부모님·친구와 함께 가는 분', text: '많이 걷는 코스, 오래 앉아 쉬는 코스, 먹는 코스 중에서 일행에 맞게 고를 수 있어요.' },
  { icon: '🗓', title: '계획 세울 시간이 없는 분', text: '숙소 비교, 예약할 것, 출발 전에 확인할 것, 챙길 것까지 체크리스트로 정리했어요.' },
];

const faqs = [
  { q: '휴대폰에서도 볼 수 있나요?', a: 'PDF 파일이라 휴대폰·태블릿·PC 어디서나 열 수 있어요. A4 크기로 만들어서 인쇄해서 들고 다니기에도 좋아요.' },
  { q: '인쇄할 때 주의할 점이 있나요?', a: '용지 A4, 여백 없음, 배경 그래픽 켜기로 설정하면 화면과 똑같이 30쪽으로 나와요.' },
  { q: '다른 날짜에 가도 쓸 수 있나요?', a: `코스·장소·이동 방법은 다른 주말에도 그대로 쓸 수 있어요. 다만 축제 일정과 가격은 ${tripDates} 기준이라, 다른 날짜라면 축제 장은 참고만 해 주세요.` },
  { q: '가격이나 영업시간이 바뀌면요?', a: `모든 정보는 ${researchedOn}에 조사했고, 정보마다 '확인됨 / 확인 필요 / 정보 없음'을 표시했어요. 가격과 영업시간은 바뀔 수 있으니 출발 전에 지도 앱에서 한 번 더 확인해 주세요.` },
];
---

<BaseLayout
  title={title}
  description={`차 없이 기차로 떠나는 부산 1박 2일. 세 가지 코스, 숙소, 11월 축제, 예산까지 A4 ${pages}쪽 PDF에 담았어요. ${priceText}.`}
  image="/images/guidebook/og.jpg"
  imageAlt={`${title} 표지와 제목`}
>
  <div class="gb">
    <section class="hero">
      <div class="wrap hero-inner">
        <div class="hero-text">
          <p class="eyebrow">🍁 가을 부산 · PDF 가이드북</p>
          <h1>부산 1박 2일<br />가이드북</h1>
          <p class="lead">
            차 없이 기차와 지하철로 떠나는 1박 2일. 해운대·광안리·영도·남포동을 도는 세 가지 코스와 숙소, 11월 축제, 예산까지
            A4 {pages}쪽에 담았어요.
          </p>
          <div class="buy-box" id="buy">
            <p class="price"><strong>{priceText}</strong><span>PDF · A4 {pages}쪽</span></p>
            {
              onSale ? (
                <a class="buy-btn" href={purchaseUrl} target="_blank" rel="noopener">
                  구매하고 바로 다운로드
                </a>
              ) : (
                <button class="buy-btn" type="button" disabled aria-describedby="buy-note">
                  결제 준비 중이에요
                </button>
              )
            }
            <p class="buy-note" id="buy-note">
              {onSale ? '결제가 끝나면 PDF 파일을 바로 내려받을 수 있어요.' : '곧 판매를 시작해요. 조금만 기다려 주세요.'}
            </p>
          </div>
        </div>
        <div class="hero-cover">
          <img src="/images/guidebook/cover.jpg" alt="광안대교 사진 위에 '부산 1박 2일 가이드북' 제목이 있는 표지" width="900" height="1273" />
        </div>
      </div>
    </section>

    <section class="wrap section">
      <h2>이런 분께 맞아요</h2>
      <div class="cards">
        {
          forWhom.map((item) => (
            <div class="card">
              <p class="card-icon" aria-hidden="true">{item.icon}</p>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="wrap section">
      <h2>안에 들어 있는 것</h2>
      <ol class="toc">
        {
          chapters.map((c) => (
            <li>
              <span class="toc-no">{c.no}</span>
              <span class="toc-body">
                <strong>{c.name}</strong>
                <span>{c.desc}</span>
              </span>
              <span class="toc-pages">{c.pages}</span>
            </li>
          ))
        }
      </ol>
      <p class="muted">맨 뒤에는 정보와 사진의 출처를 모두 적었어요 (29–30쪽).</p>
    </section>

    <section class="wrap section">
      <h2>미리 보기</h2>
      <div class="samples">
        {
          samples.map((s) => (
            <figure>
              <img src={s.src} alt={s.alt} width="900" height="1273" loading="lazy" />
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="wrap section">
      <div class="promise">
        <h2>이 가이드북의 약속</h2>
        <ul>
          <li><strong>조사한 날짜를 적었어요.</strong> 모든 정보는 {researchedOn}에 조사했어요.</li>
          <li>
            <strong>확인한 것과 못 한 것을 나눴어요.</strong>
            <span class="status ok">✓ 확인됨</span>
            <span class="status chk">! 확인 필요</span>
            <span class="status no">? 정보 없음</span> 표시로 믿을 만한 정도를 알려 드려요.
          </li>
          <li><strong>문 닫은 곳은 뺐어요.</strong> 예전에 많이 추천되던 곳도 폐점 표시가 있으면 일정에서 제외했어요.</li>
          <li><strong>출처를 모두 밝혔어요.</strong> 정보와 사진의 출처를 책 뒤에 적었어요.</li>
        </ul>
      </div>
    </section>

    <section class="wrap section">
      <h2>상품 정보</h2>
      <table class="spec">
        <tbody>
          <tr><th>형식</th><td>PDF (A4 세로, {pages}쪽, {fileSize})</td></tr>
          <tr><th>기준 일정</th><td>{tripDates}</td></tr>
          <tr><th>조사일</th><td>{researchedOn}</td></tr>
          <tr><th>여행 방식</th><td>수도권에서 고속열차(SRT)로 출발, 부산 안에서는 대중교통</td></tr>
          <tr><th>가격</th><td>{priceText}</td></tr>
        </tbody>
      </table>
    </section>

    <section class="wrap section">
      <h2>자주 묻는 질문</h2>
      <div class="faq">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="wrap section">
      <div class="cta">
        <p class="cta-title">이번 가을, 운전대 대신 창가 자리로</p>
        <p class="cta-sub">{title} · PDF {pages}쪽 · {priceText}</p>
        {
          onSale ? (
            <a class="buy-btn" href={purchaseUrl} target="_blank" rel="noopener">
              구매하고 바로 다운로드
            </a>
          ) : (
            <button class="buy-btn" type="button" disabled>
              결제 준비 중이에요
            </button>
          )
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* 가이드북과 같은 가을 색을 이 페이지 안에서만 씁니다 */
  .gb {
    --gb-paper: #fdf7ec;
    --gb-sand: #f6e7cf;
    --gb-maple: #a3401f;
    --gb-maple-deep: #6f2a12;
    --gb-amber: #c27a14;
    --gb-line: #e4d2b8;
    --gb-ink: #2f241c;
    --gb-ink-soft: #55443a;
    --gb-btn-ink: #ffffff;
    color: var(--gb-ink);
    background: var(--gb-paper);
    /* 바닥글 위 여백(80px)까지 가을 바탕으로 채움 */
    margin-bottom: -80px;
    padding-bottom: 104px;
  }
  @media (prefers-color-scheme: dark) {
    .gb {
      --gb-paper: #1f1712;
      --gb-sand: #2c211a;
      --gb-maple: #f08a62;
      --gb-maple-deep: #f4b48f;
      --gb-amber: #e8a948;
      --gb-line: #3d2e24;
      --gb-ink: #f1e6d8;
      --gb-ink-soft: #c9b8a6;
      --gb-btn-ink: #1f1712;
    }
  }
  .gb h1,
  .gb h2,
  .gb h3 {
    font-family: var(--font-body);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--gb-maple-deep);
  }
  .gb h2 {
    margin: 0 0 18px;
    font-size: 26px;
  }
  .muted {
    color: var(--gb-ink-soft);
    font-size: 15px;
  }

  /* 맨 위 */
  .hero {
    border-top: 6px solid transparent;
    border-image: linear-gradient(90deg, #b23a22, #d9822b 35%, #e6b53c 60%, #8a4f26) 1;
    padding: 56px 0 40px;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .eyebrow {
    margin: 0 0 10px;
    color: var(--gb-amber);
    font-size: 15px;
    font-weight: 700;
  }
  .hero h1 {
    margin: 0 0 16px;
    font-size: clamp(36px, 6vw, 54px);
    line-height: 1.15;
  }
  .lead {
    margin: 0 0 28px;
    color: var(--gb-ink-soft);
    font-size: 18px;
  }
  .hero-cover img {
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    border-radius: 6px;
    box-shadow: 18px 22px 0 rgba(111, 42, 18, 0.18), 0 10px 30px rgba(60, 30, 10, 0.25);
    transform: rotate(2deg);
  }

  /* 구매 */
  .buy-box {
    padding: 22px 24px;
    border: 1px solid var(--gb-line);
    border-radius: var(--radius);
    background: var(--gb-sand);
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 14px;
  }
  .price strong {
    font-size: 32px;
    font-weight: 800;
    color: var(--gb-maple-deep);
  }
  .price span {
    color: var(--gb-ink-soft);
    font-size: 15px;
  }
  .buy-btn {
    display: block;
    width: 100%;
    padding: 15px 20px;
    border: 0;
    border-radius: 12px;
    background: var(--gb-maple);
    color: var(--gb-btn-ink);
    font: inherit;
    font-size: 18px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }
  .buy-btn:hover {
    filter: brightness(1.08);
  }
  .buy-btn:focus-visible {
    outline: 3px solid var(--gb-amber);
    outline-offset: 3px;
  }
  .buy-btn:disabled {
    background: var(--gb-line);
    color: var(--gb-ink-soft);
    cursor: not-allowed;
    filter: none;
  }
  .buy-note {
    margin: 10px 0 0;
    color: var(--gb-ink-soft);
    font-size: 14.5px;
    text-align: center;
  }

  .section {
    margin-top: 64px;
  }

  /* 이런 분께 */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .card {
    padding: 22px;
    border-radius: var(--radius);
    background: var(--gb-sand);
  }
  .card-icon {
    margin: 0 0 6px;
    font-size: 30px;
    line-height: 1.2;
  }
  .card h3 {
    margin: 0 0 6px;
    font-size: 19px;
  }
  .card p {
    margin: 0;
    color: var(--gb-ink-soft);
    font-size: 16px;
  }

  /* 차례 */
  .toc {
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--gb-maple-deep);
  }
  .toc li {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 14px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--gb-line);
  }
  .toc-no {
    color: var(--gb-amber);
    font-size: 20px;
    font-weight: 800;
  }
  .toc-body {
    display: flex;
    flex-direction: column;
  }
  .toc-body strong {
    font-size: 18px;
  }
  .toc-body span {
    color: var(--gb-ink-soft);
    font-size: 15.5px;
  }
  .toc-pages {
    color: var(--gb-ink-soft);
    font-size: 14.5px;
    white-space: nowrap;
  }

  /* 미리 보기 */
  .samples {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .samples figure {
    margin: 0;
  }
  .samples img {
    width: 100%;
    border: 1px solid var(--gb-line);
    border-radius: 6px;
    box-shadow: 0 6px 18px rgba(60, 30, 10, 0.12);
  }
  .samples figcaption {
    margin-top: 8px;
    color: var(--gb-ink-soft);
    font-size: 14.5px;
    text-align: center;
  }

  /* 약속 */
  .promise {
    padding: 28px 30px;
    border-left: 6px solid var(--gb-maple);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--gb-sand);
  }
  .promise ul {
    margin: 0;
    padding-left: 20px;
  }
  .promise li + li {
    margin-top: 8px;
  }
  .status {
    display: inline-block;
    margin: 0 2px;
    padding: 0 8px;
    border: 1.5px solid currentColor;
    border-radius: 6px;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.6;
  }
  .status.ok {
    color: #3b7a2a;
  }
  .status.chk {
    color: #a05e00;
  }
  .status.no {
    color: var(--gb-ink-soft);
    border-style: dashed;
  }
  @media (prefers-color-scheme: dark) {
    .status.ok {
      color: #8fd27a;
    }
    .status.chk {
      color: #f0b45a;
    }
  }

  /* 상품 정보 */
  .spec {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
  }
  .spec th,
  .spec td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--gb-line);
    text-align: left;
    vertical-align: top;
  }
  .spec th {
    width: 130px;
    color: var(--gb-maple-deep);
    font-weight: 700;
    white-space: nowrap;
  }

  /* 질문 */
  .faq details {
    border-bottom: 1px solid var(--gb-line);
  }
  .faq summary {
    padding: 16px 0;
    font-size: 17px;
    font-weight: 700;
    cursor: pointer;
  }
  .faq summary::marker {
    color: var(--gb-maple);
  }
  .faq details p {
    margin: 0 0 16px;
    color: var(--gb-ink-soft);
  }

  /* 맨 아래 */
  .cta {
    max-width: 560px;
    margin: 0 auto;
    padding: 36px 28px;
    border-radius: var(--radius);
    background: var(--gb-sand);
    text-align: center;
  }
  .cta-title {
    margin: 0 0 6px;
    color: var(--gb-maple-deep);
    font-size: 24px;
    font-weight: 800;
  }
  .cta-sub {
    margin: 0 0 20px;
    color: var(--gb-ink-soft);
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .hero-cover {
      order: -1;
    }
    .hero-cover img {
      max-width: 260px;
    }
    .cards {
      grid-template-columns: 1fr;
    }
    .samples {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .hero {
      padding: 32px 0 24px;
    }
    .section {
      margin-top: 48px;
    }
    .gb h2 {
      font-size: 22px;
    }
    .toc li {
      grid-template-columns: 34px 1fr;
    }
    .toc-pages {
      grid-column: 2;
    }
    .promise {
      padding: 22px 20px;
    }
  }
</style>
