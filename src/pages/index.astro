---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<BaseLayout>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">TRAVEL BY TRAIN · SUBWAY · BUS</p>
      <h1>운전대 대신 창가 자리,<br />{SITE_TITLE}</h1>
      <p class="lead">{SITE_DESCRIPTION}</p>
    </div>
  </section>

  <section class="wrap">
    <h2 class="section-title">최근 글</h2>
    {
      posts.length > 0 ? (
        <div class="grid">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="empty">아직 올라온 글이 없어요. 첫 글을 준비하고 있어요.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 64px 0 48px;
  }
  .eyebrow {
    margin: 0 0 12px;
    color: var(--warm);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  h1 {
    margin: 0 0 16px;
    font-size: clamp(30px, 5vw, 46px);
  }
  .lead {
    max-width: 560px;
    margin: 0;
    color: var(--ink-soft);
    font-size: 18px;
  }
  .section-title {
    margin: 0 0 20px;
    font-size: 22px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }
  .empty {
    padding: 40px;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--ink-faint);
    text-align: center;
  }
  @media (max-width: 640px) {
    .hero {
      padding: 40px 0 32px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
