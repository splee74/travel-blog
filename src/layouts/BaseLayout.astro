---
import '../styles/global.css';
import {
  SITE_TITLE,
  SITE_TAGLINE,
  SITE_DESCRIPTION,
  SITE_LANG,
  SITE_AUTHOR,
  SITE_OG_IMAGE,
  GOOGLE_SITE_VERIFICATION,
  NAVER_SITE_VERIFICATION,
} from '../consts';
import RegionRequest from '../components/RegionRequest.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  // 글 페이지에서만 넘깁니다. 있으면 og:type이 article이 되고 작성일·태그 정보가 붙습니다.
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    section?: string;
    tags?: string[];
  };
}

const { title, description = SITE_DESCRIPTION, image, imageAlt, article } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : `${SITE_TITLE} · ${SITE_TAGLINE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;

// 공유 미리보기 이미지: 글 대표 사진이 없으면 기본 이미지(1200×630)를 씁니다.
const ogImage = new URL(image ?? SITE_OG_IMAGE.src, Astro.site);
const ogImageAlt = image ? imageAlt || title : SITE_OG_IMAGE.alt;

// 검색엔진용 구조화 데이터 (구글 검색 결과에 날짜·작성자 등이 보이게 도와줌)
const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: [ogImage.href],
      datePublished: article.publishedTime.toISOString(),
      dateModified: (article.modifiedTime ?? article.publishedTime).toISOString(),
      author: { '@type': 'Person', name: SITE_AUTHOR },
      publisher: { '@type': 'Organization', name: SITE_TITLE },
      mainEntityOfPage: canonical.href,
      inLanguage: SITE_LANG,
      keywords: article.tags?.join(', '),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      url: new URL('/', Astro.site).href,
      inLanguage: SITE_LANG,
    };

const nav = [
  { href: '/', label: '글' },
  { href: '/tags/', label: '지역·태그' },
  { href: '/about/', label: '소개' },
];
const isActive = (href: string) => (href === '/' ? path === '/' || path.startsWith('/posts/') : path.startsWith(href));
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE_AUTHOR} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#e8f4fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1a24" media="(prefers-color-scheme: dark)" />
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    {NAVER_SITE_VERIFICATION && <meta name="naver-site-verification" content={NAVER_SITE_VERIFICATION} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- 카카오톡·페이스북·디스코드 등 링크 공유 미리보기 -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {!image && <meta property="og:image:width" content={String(SITE_OG_IMAGE.width)} />}
    {!image && <meta property="og:image:height" content={String(SITE_OG_IMAGE.height)} />}
    {article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- X(트위터)·슬랙 등 -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE_TITLE} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&display=swap" rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="7" y="4" width="18" height="19" rx="5" fill="currentColor"></rect>
            <rect x="10" y="8" width="12" height="6" rx="1.5" fill="var(--bg)"></rect>
            <circle cx="12" cy="18.5" r="1.6" fill="var(--bg)"></circle>
            <circle cx="20" cy="18.5" r="1.6" fill="var(--bg)"></circle>
            <path d="M10 23 L6 28 M22 23 L26 28" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span>
            <strong>{SITE_TITLE}</strong>
            <small>{SITE_TAGLINE}</small>
          </span>
        </a>
        <div class="header-actions">
          <nav aria-label="주 메뉴">
            {nav.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
          <RegionRequest />
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>© {new Date().getFullYear()} {SITE_TITLE}</p>
        <p>
          <a href="/rss.xml">RSS 구독</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }
  .brand-mark {
    width: 32px;
    height: 32px;
    color: var(--accent);
    flex: none;
  }
  .brand span {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .brand strong {
    font-family: var(--font-head);
    font-size: 20px;
  }
  .brand small {
    color: var(--ink-faint);
    font-size: 12.5px;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  nav {
    display: flex;
    gap: 4px;
  }
  nav a {
    padding: 6px 12px;
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--ink);
    background: var(--line);
  }
  nav a[aria-current='page'] {
    color: var(--accent);
    background: var(--accent-soft);
  }
  main {
    min-height: 70vh;
  }
  .site-footer {
    margin-top: 80px;
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
    font-size: 14px;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    padding-top: 20px;
    padding-bottom: 32px;
  }
  .footer-inner p {
    margin: 0;
  }
  .footer-inner a {
    color: var(--ink-soft);
  }
  @media (max-width: 560px) {
    .brand small {
      display: none;
    }
    nav a {
      padding: 6px 9px;
      font-size: 14px;
    }
  }
  @media (max-width: 480px) {
    .header-inner {
      flex-wrap: wrap;
      padding-top: 10px;
      padding-bottom: 10px;
    }
    .header-actions {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
