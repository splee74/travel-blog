---
import { formatDate, readingMinutes, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, region, cover, coverAlt, draft } = post.data;
const href = `/posts/${post.id}/`;
---

<article class="card">
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
    {cover ? <img src={cover} alt={coverAlt} loading="lazy" /> : <span class="thumb-fallback">{region ?? '여행'}</span>}
  </a>
  <div class="body">
    <p class="meta">
      {draft && <span class="draft-badge">초안</span>}
      {region && <span class="chip">{region}</span>}
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes(post.body)}분</span>
    </p>
    <h2><a href={href}>{title}</a></h2>
    <p class="desc">{description}</p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: transform 0.2s ease;
  }
  .card:hover {
    transform: translateY(-2px);
  }
  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--accent-soft);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--accent);
    font-family: var(--font-head);
    font-size: 28px;
    background:
      radial-gradient(circle at 20% 120%, color-mix(in srgb, var(--accent) 22%, transparent) 0 40%, transparent 41%),
      radial-gradient(circle at 85% 130%, color-mix(in srgb, var(--warm) 18%, transparent) 0 35%, transparent 36%),
      var(--accent-soft);
  }
  .body {
    padding: 18px 20px 22px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0 0 8px;
    color: var(--ink-faint);
    font-size: 14px;
  }
  h2 {
    margin: 0 0 8px;
    font-size: 21px;
  }
  h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--accent);
  }
  .desc {
    margin: 0;
    color: var(--ink-soft);
    font-size: 15.5px;
    line-height: 1.65;
  }
</style>
